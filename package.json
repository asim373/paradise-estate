    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",

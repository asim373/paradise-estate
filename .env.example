# Public application configuration. Add local values to .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only PostgreSQL connections for Prisma. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/paradise_estate?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/paradise_estate?schema=public"
